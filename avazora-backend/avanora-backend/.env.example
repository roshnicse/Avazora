# Copy this file to .env and fill in your real values.
# If DATABASE_URL is left unset, the app falls back to a local
# SQLite file (avanora.db) so it runs with zero setup.

DATABASE_URL=mysql+pymysql://avanora_user:yourpassword@localhost:3306/avanora

CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5500

JWT_SECRET=change-this-to-a-long-random-string
